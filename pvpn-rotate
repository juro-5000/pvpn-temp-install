#!/usr/bin/env python3
"""pvpn-rotate - stateful ProtonVPN server rotator.

Keeps a small state file that remembers *which servers are on cooldown* (because
they just got rate-limited) and a global mode, then rotates to the fastest
available Netherlands server that is not on cooldown.

Used by the opencode ``vpn-rotate`` plugin, but usable on its own::

    pvpn-rotate status
    pvpn-rotate mode auto
    pvpn-rotate switch --reason "opencode 429"
    pvpn-rotate log -n 20
    pvpn-rotate cooldowns

State (``~/.local/state/pvpn-rotate/state.json``)::

    {"mode": "ask",
     "cooldowns": {"NL-FREE#281": {"until": 1791900000000, "set_at": ..., "reason": "..."}}}

Cooldown defaults to 8 hours.  ``switch`` never runs preemptively - it is only
called when a limit has actually been detected.
"""

from __future__ import annotations

import argparse
import fcntl
import json
import os
import sys
import time
from typing import Optional

def _resolve_pvpn_dir() -> str:
    env = os.environ.get("PVPN_DIR")
    if env and os.path.isfile(os.path.join(env, "pvpnlib.py")):
        return env
    here = os.path.dirname(os.path.realpath(__file__))
    candidates = [
        here,
        os.path.expanduser("~/.local/share/pvpn"),
        os.path.expanduser("~/pvpn"),
        "/opt/pvpn",
        "/home/juro/pvpn",
    ]
    for c in candidates:
        if c and os.path.isfile(os.path.join(c, "pvpnlib.py")):
            return c
    return here

_PVPN_DIR = _resolve_pvpn_dir()
if _PVPN_DIR not in sys.path:
    sys.path.insert(0, _PVPN_DIR)

import pvpnlib  # noqa: E402
import pvpn_servers  # noqa: E402

STATE_DIR = os.path.expanduser("~/.local/state/pvpn-rotate")
STATE_FILE = os.path.join(STATE_DIR, "state.json")
LOCK_FILE = os.path.join(STATE_DIR, "state.lock")
LOG_FILE = os.path.join(STATE_DIR, "detections.log")

VALID_MODES = ("off", "ask", "auto")
DEFAULT_MODE = "ask"
DEFAULT_COOLDOWN_SECONDS = 8 * 3600
DEFAULT_COUNTRY = "nl"


# --------------------------------------------------------------------------- #
# state
# --------------------------------------------------------------------------- #
def _default_state() -> dict:
    return {"mode": DEFAULT_MODE, "cooldowns": {}, "version": 1}


def _ensure_dir() -> None:
    os.makedirs(STATE_DIR, exist_ok=True)


def load_state() -> dict:
    try:
        with open(STATE_FILE, "r", encoding="utf-8") as handle:
            data = json.load(handle)
    except (OSError, ValueError):
        return _default_state()
    if not isinstance(data, dict):
        return _default_state()
    data.setdefault("mode", DEFAULT_MODE)
    data.setdefault("cooldowns", {})
    if data["mode"] not in VALID_MODES:
        data["mode"] = DEFAULT_MODE
    return data


def save_state(state: dict) -> None:
    _ensure_dir()
    tmp = STATE_FILE + ".tmp"
    with open(tmp, "w", encoding="utf-8") as handle:
        json.dump(state, handle, indent=2, sort_keys=True)
    os.replace(tmp, STATE_FILE)


def _now_ms() -> int:
    return int(time.time() * 1000)


def active_cooldowns(state: dict, now_ms: Optional[int] = None) -> dict:
    now_ms = now_ms if now_ms is not None else _now_ms()
    return {name: info for name, info in state.get("cooldowns", {}).items()
            if int(info.get("until", 0)) > now_ms}


def _prune(state: dict) -> None:
    now = _now_ms()
    state["cooldowns"] = {n: i for n, i in state.get("cooldowns", {}).items()
                          if int(i.get("until", 0)) > now}


def log_event(record: dict) -> None:
    _ensure_dir()
    record = {"ts": _now_ms(), **record}
    try:
        with open(LOG_FILE, "a", encoding="utf-8") as handle:
            handle.write(json.dumps(record, ensure_ascii=False) + "\n")
    except OSError:
        pass


# --------------------------------------------------------------------------- #
# locking
# --------------------------------------------------------------------------- #
class _Lock:
    def __init__(self) -> None:
        self._fh = None

    def __enter__(self):
        _ensure_dir()
        self._fh = open(LOCK_FILE, "w")
        fcntl.flock(self._fh.fileno(), fcntl.LOCK_EX)
        return self

    def __exit__(self, *exc):
        if self._fh:
            fcntl.flock(self._fh.fileno(), fcntl.LOCK_UN)
            self._fh.close()
            self._fh = None
        return False


# --------------------------------------------------------------------------- #
# commands
# --------------------------------------------------------------------------- #
def cmd_mode(args) -> int:
    if args.value not in VALID_MODES:
        sys.stderr.write(f"error: mode must be one of {', '.join(VALID_MODES)}\n")
        return 2
    with _Lock():
        state = load_state()
        state["mode"] = args.value
        save_state(state)
    log_event({"event": "mode", "mode": args.value})
    print("mode: " + args.value)
    return 0


def cmd_get_mode(args) -> int:
    print(load_state().get("mode", DEFAULT_MODE))
    return 0


def cmd_status(args) -> int:
    state = load_state()
    now = _now_ms()
    try:
        status = pvpnlib.status()
    except Exception as exc:  # noqa: BLE001 - reported to the user
        status = {"connected": None, "server": None, "ipv4": None, "error": str(exc)}

    cooldowns = active_cooldowns(state, now)
    payload = {
        "mode": state.get("mode", DEFAULT_MODE),
        "connected": status.get("connected"),
        "server": status.get("server"),
        "iface": status.get("device"),
        "ipv4": status.get("ipv4"),
        "active_cooldowns": {
            name: {"seconds_left": max(0, (int(info.get("until", 0)) - now) // 1000),
                   "reason": info.get("reason", "")}
            for name, info in sorted(cooldowns.items())
        },
        "cooldown_count": len(cooldowns),
    }
    if args.json:
        print(json.dumps(payload, indent=2, ensure_ascii=False))
    else:
        print(f"mode:      {payload['mode']}")
        print(f"connected: {payload['connected']}")
        print(f"server:    {payload['server']}")
        print(f"ipv4:      {payload['ipv4']}")
        print(f"cooldowns: {payload['cooldown_count']}")
        for name, info in payload["active_cooldowns"].items():
            mins = info["seconds_left"] // 60
            print(f"  - {name}: {mins} min left ({info['reason']})")
    return 0


def cmd_cooldowns(args) -> int:
    state = load_state()
    payload = active_cooldowns(state)
    if args.json:
        print(json.dumps(payload, indent=2, ensure_ascii=False))
    else:
        if not payload:
            print("(no active cooldowns)")
        for name, info in sorted(payload.items()):
            print(f"{name}\tuntil={info.get('until')}\t{info.get('reason', '')}")
    return 0


def cmd_clear(args) -> int:
    with _Lock():
        state = load_state()
        if args.server:
            state.get("cooldowns", {}).pop(args.server, None)
        else:
            state["cooldowns"] = {}
        save_state(state)
    print("cleared")
    return 0


def cmd_switch(args) -> int:
    cooldown_ms = int(args.cooldown_seconds * 1000)
    with _Lock():
        state = load_state()
        _prune(state)
        now = _now_ms()

        try:
            current = pvpnlib.status()
        except Exception as exc:  # noqa: BLE001
            current = {"connected": False, "server": None, "ipv4": None, "error": str(exc)}

        current_server = current.get("server")
        if current_server:
            state.setdefault("cooldowns", {})[current_server] = {
                "until": now + cooldown_ms,
                "set_at": now,
                       "reason": args.reason or "manual",
            }
            log_event({"event": "cooldown", "server": current_server,
                "reason": args.reason or "manual",
                       "seconds": args.cooldown_seconds})

        exclude = set(active_cooldowns(state, now).keys())
        exclude.add(current_server) if current_server else None

        result = pvpn_servers.list_servers(country=args.country, only_free=True,
                                           sort="score")
        if not result.get("ok"):
            save_state(state)
            payload = {"ok": False, "error": result.get("error", "server list failed"),
                       "from": current_server, "mode": state.get("mode")}
            log_event({"event": "switch_failed", **payload})
            _emit_switch(payload, args)
            return 1

        pool = [s for s in result["servers"]
                if s["name"] not in exclude and not s.get("under_maintenance")]

        if not pool:
            save_state(state)
            payload = {"ok": False, "error": "no available NL server left (pool exhausted)",
                       "from": current_server, "cooldown_count": len(exclude)}
            log_event({"event": "pool_exhausted", **payload})
            _emit_switch(payload, args)
            return 1

        target = pool[0]
        connect = pvpnlib.connect(server=target["name"], timeout=args.timeout)
        verified = None
        if connect.get("ok"):
            try:
                verified = pvpnlib.status()
            except Exception:  # noqa: BLE001
                verified = None

        payload = {
            "ok": bool(connect.get("ok")),
            "from": current_server,
            "to": target["name"],
            "city": target.get("city"),
            "load": target.get("load"),
            "score": target.get("score"),
            "ip": (verified or {}).get("ipv4") or connect.get("ip"),
            "verified_server": (verified or {}).get("server"),
            "mode": state.get("mode"),
            "excluded": sorted(x for x in exclude if x),
            "output": connect.get("output") or connect.get("error") or "",
        }
        save_state(state)
        log_event({"event": "switch", "ok": payload["ok"], "from": payload["from"],
                   "to": payload["to"], "ip": payload.get("ip"),
                   "reason": args.reason or "manual"})
        _emit_switch(payload, args)
        return 0 if payload["ok"] else 1


def _emit_switch(payload: dict, args) -> None:
    if getattr(args, "json", False):
        print(json.dumps(payload, indent=2, ensure_ascii=False))
    else:
        if payload.get("ok"):
            print(f"switched: {payload.get('from')} -> {payload.get('to')} "
                  f"({payload.get('ip')})")
        else:
            print("switch failed: " + str(payload.get("error") or payload.get("output")))


def cmd_log(args) -> int:
    try:
        with open(LOG_FILE, "r", encoding="utf-8") as handle:
            lines = handle.readlines()
    except OSError:
        lines = []
    lines = lines[-args.n:] if args.n > 0 else lines
    if args.json:
        print("".join(lines), end="")
    else:
        for line in lines:
            try:
                rec = json.loads(line)
            except ValueError:
                print(line.rstrip())
                continue
            ts = rec.pop("ts", None)
            when = time.strftime("%H:%M:%S", time.localtime(ts / 1000)) if ts else "?"
            print(f"{when}  " + json.dumps(rec, ensure_ascii=False))
    return 0


# --------------------------------------------------------------------------- #
# cli
# --------------------------------------------------------------------------- #
def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="pvpn-rotate",
                                     description="Rotate ProtonVPN servers on rate limits.")
    sub = parser.add_subparsers(dest="command", required=False)

    def with_json(p):
        p.add_argument("--json", action="store_true", help="machine-readable output")
        return p

    p_status = with_json(sub.add_parser("status", help="show mode, current server and cooldowns"))
    p_status.set_defaults(func=cmd_status)

    p_getmode = sub.add_parser("get-mode", help="print just the mode (off|ask|auto)")
    p_getmode.set_defaults(func=cmd_get_mode)

    p_mode = with_json(sub.add_parser("mode", help="set the mode"))
    p_mode.add_argument("value", choices=VALID_MODES)
    p_mode.set_defaults(func=cmd_mode)

    for _name in VALID_MODES:
        p_alias = with_json(sub.add_parser(_name, help=f"shortcut for `mode {_name}`"))
        p_alias.set_defaults(func=cmd_mode, value=_name)

    p_switch = with_json(sub.add_parser("switch", help="cool the current server and move to the next fastest"))
    p_switch.add_argument("--reason", default=None, help="why the switch happened")
    p_switch.add_argument("--cooldown-seconds", type=float, default=DEFAULT_COOLDOWN_SECONDS,
                          help="how long to cool the current server (default 8h)")
    p_switch.add_argument("--cooldown-hours", type=float, default=None,
                          help="same as --cooldown-seconds, in hours")
    p_switch.add_argument("--country", default=DEFAULT_COUNTRY)
    p_switch.add_argument("--timeout", type=int, default=pvpnlib.DEFAULT_TIMEOUT)
    p_switch.set_defaults(func=cmd_switch)

    p_cd = with_json(sub.add_parser("cooldowns", help="list active cooldowns"))
    p_cd.set_defaults(func=cmd_cooldowns)

    p_clear = sub.add_parser("clear", help="clear cooldowns")
    p_clear.add_argument("--server", default=None, help="clear one server only")
    p_clear.set_defaults(func=cmd_clear)

    p_log = with_json(sub.add_parser("log", help="show recent detection log"))
    p_log.add_argument("-n", type=int, default=20)
    p_log.set_defaults(func=cmd_log)
    return parser


def main(argv=None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    if getattr(args, "command", None) is None:
        args = parser.parse_args(["status"])
    if getattr(args, "cooldown_hours", None) is not None:
        args.cooldown_seconds = args.cooldown_hours * 3600
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
